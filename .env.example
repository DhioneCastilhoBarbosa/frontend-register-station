# Desenvolvimento local (`npm run dev`) — proxy Vite
VITE_API_URL=/api

# Produção — use `.env.production` ou defina no CI:
# VITE_API_URL=https://api-register.api-castilho.com.br

# Credenciais do painel — login automático (embutidas no bundle no build)
VITE_AUTH_EMAIL=voce@empresa.com
VITE_AUTH_PASSWORD=sua-senha

# Código de licença enviado em todos os cadastros (P3D-/12M-/36M-…)
VITE_LICENSE_CODE=P3D-sua-licenca-aqui
